# ── LLM Backend ──────────────────────────────────────────────────────────────
# "nvidia" → NVIDIA NIM (api.nvidia.com, OpenAI-compatible)
# "ollama" → local Ollama (http://localhost:11434, OpenAI-compatible)
LLM_BACKEND=nvidia

# NVIDIA NIM — get a free API key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Ollama (local) — only needed if LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Telegram ─────────────────────────────────────────────────────────────────
# 1. Message @BotFather → /newbot → copy token
# 2. Message @userinfobot to get your user ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ── Voice ─────────────────────────────────────────────────────────────────────
VOICE_ENABLED=true
WAKE_WORD_MODEL=hey_jarvis         # openwakeword built-in model
WAKE_WORD_THRESHOLD=0.5
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium | large
WHISPER_DEVICE=cuda                # cuda | cpu
SILENCE_TIMEOUT=2.0

# TTS — download model files from https://huggingface.co/rhasspy/piper-voices
# Place .onnx + .onnx.json in ~/.local/share/piper/
TTS_VOICE_MODEL=en_GB-northern_english_male-medium

# ── GitHub (coding agent + self-evolution) ────────────────────────────────────
# Create a fine-grained token at https://github.com/settings/tokens
# Scopes needed: repo (contents, pull requests)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/gawdbot

# ── Self-Evolution ────────────────────────────────────────────────────────────
SELF_EVOLVE_ENABLED=true
SELF_EVOLVE_AUTO_MERGE=false       # true = auto-merge to main (risky), false = creates PR

# ── Webhook server ────────────────────────────────────────────────────────────
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change-me-to-a-random-secret   # Set this! Unauthenticated if empty.

# ── Memory ────────────────────────────────────────────────────────────────────
MEMORY_MAX_RESULTS=5
MEMORY_SCORE_THRESHOLD=0.6
CONVERSATION_HISTORY_LIMIT=20
